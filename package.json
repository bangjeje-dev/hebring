{
  "name": "hebring",
  "version": "0.1.0",
  "description": "A modern, lightweight, and understandable CSS framework for building web interfaces.",
  "type": "module",
  "files": [
    "dist",
    "src",
    "ecosystem",
    "README.md",
    "LICENSE"
  ],
  "style": "./dist/hebring.css",
  "exports": {
    ".": "./dist/hebring.css",
    "./css": "./dist/hebring.css",
    "./min": "./dist/hebring.min.css",
    "./icons/*": "./ecosystem/icons/*",
    "./themes/*": "./ecosystem/themes/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "css",
    "css-framework",
    "framework-agnostic",
    "lightweight",
    "modern-css"
  ],
  "author": "HEBRING Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebring/hebring.git"
  },
  "bugs": {
    "url": "https://github.com/hebring/hebring/issues"
  },
  "homepage": "https://github.com/hebring/hebring#readme",
  "scripts": {
    "build:css": "lightningcss --bundle src/index.css -o dist/hebring.css",
    "build:min": "lightningcss --bundle --minify src/index.css -o dist/hebring.min.css",
    "build": "npm run build:css && npm run build:min"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.33.0"
  }
}
